[Unit]
Description=Dynabook keyboard-backlight Fn-key toggle daemon
Documentation=https://github.com/<you>/dynabook-x40k-acpi
After=systemd-modules-load.service
ConditionPathExists=/sys/devices/LNXSYSTM:00/LNXSYBUS:00/DNBK0001:00

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'until grep -rl "Toshiba input device" /sys/class/input/*/name 2>/dev/null; do sleep 0.5; done'
ExecStart=/usr/local/bin/dynabook-kbdbacklightd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
